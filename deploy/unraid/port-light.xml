<?xml version="1.0"?>
<Container version="2">
  <Name>port-light</Name>
  <Repository>stepaniah/port-light:v0.5.3</Repository>
  <Registry>https://hub.docker.com/r/stepaniah/port-light/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/StepaniaH/port-light/issues</Support>
  <Project>https://github.com/StepaniaH/port-light</Project>
  <Overview>Port occupancy map for a Docker host. Merges listen tables, container mappings, and Compose declarations into a traffic-light grid. Not a container manager — no start/stop/logs.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:2100]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/StepaniaH/port-light/main/deploy/unraid/port-light.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/StepaniaH/port-light/main/docs/icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText>Ko-fi</DonateText>
  <DonateLink>https://ko-fi.com/stepaniah</DonateLink>
  <Requires>Do not enable privileged. Keep docker.sock and /proc read-only. Pin a version tag.</Requires>
  <Config Name="WebUI" Target="2100" Default="2100" Mode="tcp" Description="Port-Light web UI" Type="Port" Display="always" Required="true" Mask="false">2100</Config>
  <Config Name="Compose stacks" Target="/compose" Default="" Mode="ro" Description="Folder of compose projects (read-only)" Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="Docker socket" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="ro" Description="Docker socket (read-only)" Type="Path" Display="always" Required="true" Mask="false">/var/run/docker.sock</Config>
  <Config Name="Host proc" Target="/host/proc" Default="/proc" Mode="ro" Description="Host /proc for listen detection (read-only)" Type="Path" Display="always" Required="true" Mask="false">/proc</Config>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/port-light" Mode="rw" Description="JSON store for manual and hidden ports" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/port-light</Config>
  <Config Name="AUTH_USER" Target="AUTH_USER" Default="" Description="Optional HTTP Basic Auth username" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="AUTH_PASSWORD" Target="AUTH_PASSWORD" Default="" Description="Optional HTTP Basic Auth password" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="HIDDEN_UNLOCK_PASSWORD" Target="HIDDEN_UNLOCK_PASSWORD" Default="" Description="Optional password to reveal hidden ports in the API" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="COMPOSE_SCAN_DIR" Target="COMPOSE_SCAN_DIR" Default="/compose" Description="In-container compose scan path" Type="Variable" Display="advanced" Required="false" Mask="false">/compose</Config>
  <Config Name="URL_HOST" Target="URL_HOST" Default="" Description="Hostname for guessed http(s) links (optional)" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="THEME" Target="THEME" Default="system" Description="system, dark, or light" Type="Variable" Display="advanced" Required="false" Mask="false">system</Config>
  <Config Name="LOCALE" Target="LOCALE" Default="auto" Description="auto, en, zh-CN, zh-TW, or ja" Type="Variable" Display="advanced" Required="false" Mask="false">auto</Config>
</Container>
