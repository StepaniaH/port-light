# Directory containing your compose project folders.
# Each subdirectory should contain docker-compose.yml / compose.yml.
COMPOSE_SCAN_DIR=~/your-compose-dir

# Used only for the "free" summary count, not for filling the grid with green cells.
PORT_RANGE_START=1
PORT_RANGE_END=9999

# Custom port names (gitignored). Copy custom_ports.example.json.
# Create this as a file before docker compose up if it is bind-mounted.
CUSTOM_PORTS_FILE=./custom_ports.json

# Optional HTTP Basic Auth. Leave unset for open LAN use.
# AUTH_USER=admin
# AUTH_PASSWORD=change-me

# Optional. When set, hidden-from-grid ports are withheld until the UI sends this value.
# HIDDEN_UNLOCK_PASSWORD=change-me-too
