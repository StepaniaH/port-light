# Directory containing your compose project folders.
# Nested compose.yml / docker-compose.yml files are walked up to COMPOSE_SCAN_DEPTH.
COMPOSE_SCAN_DIR=~/your-compose-dir
# COMPOSE_SCAN_DEPTH=4
# COMPOSE_SCAN_MAX_FILES=400
# Discovery-only exclusions; folder names, not paths. Also editable in Settings → Occupancy.
# COMPOSE_SCAN_EXCLUDE_DIRS=data,postgres-data
# Enabled sources; omit those intentionally not used by this deployment.
# PORT_LIGHT_SCANNERS=listen,docker,compose
# PORT_LIGHT_SCAN_TIMEOUT_S=10

# Used only for the "free" summary count, not for filling the grid with green cells.
PORT_RANGE_START=1
PORT_RANGE_END=9999

# Appearance / URLs (also editable in the Web UI Settings page).
# LOCALE=auto
# THEME_MODE=system
# THEME_PALETTE=
#   Named palettes: gruvbox, catppuccin, nord, dracula, tokyo-night, one-dark,
#   solarized, everforest, rose-pine, kanagawa (brightness follows THEME_MODE).
# GRID_DENSITY=standard
# SHOW_BIND_ADDRESSES=false
# SHOW_BIND_IPV4=true
# SHOW_BIND_IPV6=true
# Dashboard polling interval, 1000–300000 ms. The Settings slider shows a
# recommended peer capacity; local background scans remain capped at 30s.
# REFRESH_MS=5000
# Multi-machine layout: waterfall (default) or tabs; Settings → Appearance → Cards.
# PORT_LIGHT_HOST_LAYOUT=waterfall
# URL_HOST=nas.lan
# URL_SCHEME=auto
# PORT_LIGHT_SETTINGS_SOURCE=auto
# SETTINGS_READONLY=0

# Custom port names (gitignored). Copy custom_ports.example.json.
# Create this as a file before docker compose up if it is bind-mounted.
CUSTOM_PORTS_FILE=./custom_ports.json

# Optional HTTP Basic Auth. Leave unset for open LAN use.
# AUTH_USER=admin
# AUTH_PASSWORD=change-me

# Optional. When set, hidden-from-grid ports are withheld until the UI sends this value.
# HIDDEN_UNLOCK_PASSWORD=change-me-too

# Label for this machine; also editable in Settings → Occupancy.
# PORT_LIGHT_HOST_NAME=Studio
# Optional plain-text note below the machine name, up to 120 characters.
# Visible to dashboard/API users. Do not include passwords or tokens.
# PORT_LIGHT_HOST_DESCRIPTION=Tailscale 100.64.0.10
# Up to 32 other Port-Light origins. Used when the data file has no peers key,
# or when PORT_LIGHT_SETTINGS_SOURCE=env.
# PORT_LIGHT_PEERS=[{"name":"NAS","url":"http://10.0.0.2:2100","description":"Tailscale 100.64.0.12"}]
