# Directory containing your compose project folders.
# Nested compose.yml / docker-compose.yml files are walked up to COMPOSE_SCAN_DEPTH.
COMPOSE_SCAN_DIR=~/your-compose-dir
# COMPOSE_SCAN_DEPTH=4
# COMPOSE_SCAN_MAX_FILES=400

# Used only for the "free" summary count, not for filling the grid with green cells.
PORT_RANGE_START=1
PORT_RANGE_END=9999

# Appearance / URLs (also editable in the Web UI Settings page).
# LOCALE=auto
# THEME=system
#   Named palettes: gruvbox, catppuccin, nord, dracula, tokyo-night, one-dark,
#   solarized, everforest, rose-pine, kanagawa (+ *-light / catppuccin-latte).
# GRID_DENSITY=comfortable
# REFRESH_MS=5000
# URL_HOST=nas.lan
# URL_SCHEME=auto
# PORT_LIGHT_SETTINGS_SOURCE=auto
# SETTINGS_READONLY=0

# Custom port names (gitignored). Copy custom_ports.example.json.
# Create this as a file before docker compose up if it is bind-mounted.
CUSTOM_PORTS_FILE=./custom_ports.json

# Optional HTTP Basic Auth. Leave unset for open LAN use.
# AUTH_USER=admin
# AUTH_PASSWORD=change-me

# Optional. When set, hidden-from-grid ports are withheld until the UI sends this value.
# HIDDEN_UNLOCK_PASSWORD=change-me-too

# Label for this machine when other occupancy maps are shown.
# PORT_LIGHT_HOST_NAME=Studio
# Other Port-Light origins. Used when the data file has no peers key, or when
# PORT_LIGHT_SETTINGS_SOURCE=env.
# PORT_LIGHT_PEERS=[{"name":"NAS","url":"http://10.0.0.2:2100"}]
